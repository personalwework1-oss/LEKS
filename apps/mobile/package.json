{
  "name": "@leks/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "LEKS for iOS and Android.",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo install --check"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "*",
    "@leks/protocol": "workspace:*",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^150.1.0",
    "@noble/curves": "^2.4.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-haptics": "~58.0.0",
    "expo-image-manipulator": "~58.0.0",
    "expo-image-picker": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-local-authentication": "~58.0.0",
    "expo-notifications": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-sqlite": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "livekit-client": "^2.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "~19.3.0",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@noble/.*|@leks/.*)"
    ]
  }
}
