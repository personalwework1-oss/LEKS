{
  "expo": {
    "name": "LEKS",
    "slug": "leks",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.leks.messenger",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID защищает вход в LEKS."
      }
    },
    "android": {
      "package": "app.leks.messenger",
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        { "faceIDPermission": "Face ID защищает вход в LEKS." }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "LEKS записывает звук, только когда вы записываете голосовое сообщение.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LEKS открывает фото и видео, только когда вы сами выбираете их для отправки.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141416",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://188-245-92-101.sslip.io"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
