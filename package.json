{
  "name": "leks",
  "private": true,
  "description": "Private messenger for iOS and Android: server, shared protocol and encryption core.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:server": "pnpm --filter @leks/server dev"
  }
}
